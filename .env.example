# --- App ---
# Public base URL. Local: http://localhost:3000  Prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. NEVER expose to the browser. Used by cron and token storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Must exactly match an Authorized redirect URI in Google Cloud:
#   http://localhost:3000/api/google/callback
#   https://your-app.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Security ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Limits ---
FREE_DRAFTS_PER_MONTH=10

# --- Optional: email notifications via Resend ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=AutoFly_Review <notify@yourdomain.com>
